# FlashGen environment — copy to .env (same file the systemd unit and the
# flashgen-mcp container both read; docker-compose.yml loads it via env_file: ../.env).
#
#   cp .env.example .env   &&   edit values
#
# Bearer token Claude presents to the MCP server (OAuth token endpoint echoes it).
FLASHGEN_MCP_TOKEN=

# TTS / generation providers (set at least the one you use).
OPENAI_API_KEY=
GEMINI_API_KEY=

# NOTE: do NOT set ANKI_CONNECT_URL here. The flashgen-mcp container overrides it
# to http://anki:8765 in docker-compose.yml so it reaches AnkiConnect over the
# private compose network. The CLI defaults to http://127.0.0.1:8765.
